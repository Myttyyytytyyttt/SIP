# Copy this file to .env and fill only the section required by the command.
# Never commit .env or paste private keys into logs, tickets, or deployment
# manifests. Blank values are intentional; no deployment addresses are known.

# Robinhood Testnet
RH_TESTNET_RPC_URL=
RH_TESTNET_CHAIN_ID=46630

# Isolated PUBLIC_TESTNET_SYNTHETIC drill on Robinhood Chain testnet.
# This is deliberately EOA-administered test infrastructure. It does not
# validate the production Safe/timelock topology or real Stock Tokens.
PUBLIC_TESTNET_DRILL_ACKNOWLEDGE_SYNTHETIC=false
PUBLIC_TESTNET_DRILL_BROADCAST_CONFIRMATION=
PUBLIC_TESTNET_DRILL_CONFIRMATIONS=2
PUBLIC_TESTNET_DRILL_RUN_ID=

# Explorer-listed testnet WETH as checked on 2026-07-26. Reconfirm the address,
# derive its live runtime codehash, and set that hash before every new run.
PUBLIC_TESTNET_DRILL_WETH_ADDRESS=0x7943e237c7F95DA44E0301572D358911207852Fa
PUBLIC_TESTNET_DRILL_WETH_CODEHASH=0x5706be52f64875fee65a2cec0d80e47a23d8793cbe85d214b48445e2d05f5353

# Use five new, distinct, disposable keys. Fund only the deployer from the
# official faucet; the deploy phase distributes the configured test ETH.
PUBLIC_TESTNET_DRILL_DEPLOYER_PRIVATE_KEY=
PUBLIC_TESTNET_DRILL_VAULT_ADMIN_PRIVATE_KEY=
PUBLIC_TESTNET_DRILL_TRADER_A_PRIVATE_KEY=
PUBLIC_TESTNET_DRILL_TRADER_B_PRIVATE_KEY=
PUBLIC_TESTNET_DRILL_ATTESTER_PRIVATE_KEY=

# Small defaults in wei. Increase gas budgets only after a read-only preflight;
# do not scale the synthetic trade amounts merely because more faucet ETH exists.
PUBLIC_TESTNET_DRILL_VAULT_ADMIN_FUNDING_WEI=300000000000000
PUBLIC_TESTNET_DRILL_TRADER_A_FUNDING_WEI=500000000000000
PUBLIC_TESTNET_DRILL_TRADER_B_FUNDING_WEI=400000000000000
PUBLIC_TESTNET_DRILL_MARKET_LIQUIDITY_WEI=200000000000000
PUBLIC_TESTNET_DRILL_DEPLOYER_GAS_BUDGET_WEI=6000000000000000
PUBLIC_TESTNET_DRILL_PARTICIPANT_GAS_BUDGET_WEI=50000000000000
PUBLIC_TESTNET_DRILL_TRADE_A_WEI=100000000000000
PUBLIC_TESTNET_DRILL_TRADE_B_WEI=50000000000000
PUBLIC_TESTNET_DRILL_INITIAL_PRICE_WEI=1000000000000000000
PUBLIC_TESTNET_DRILL_FINAL_PRICE_WEI=1500000000000000000
PUBLIC_TESTNET_DRILL_TRADER_A_INITIAL_BPS=2000
PUBLIC_TESTNET_DRILL_TRADER_A_UPDATED_BPS=2500
PUBLIC_TESTNET_DRILL_TRADER_B_BPS=3000
PUBLIC_TESTNET_DRILL_MIN_CONTRIBUTION_WEI=1000000000
PUBLIC_TESTNET_DRILL_TRADING_FLOOR_WEI=20000000000000
PUBLIC_TESTNET_DRILL_GAS_RESERVE_WEI=20000000000000
PUBLIC_TESTNET_DRILL_INVITE_LIFETIME_SECONDS=86400
PUBLIC_TESTNET_DRILL_TX_DEADLINE_SECONDS=600

# DeployNuvem.s.sol
DEPLOYER_PRIVATE_KEY=
NUVEM_INITIAL_FEE_BPS=
NUVEM_CORPORATE_MULTISIG=
NUVEM_GUARDIAN=
NUVEM_TREASURY=
NUVEM_ATTESTER=
NUVEM_WETH_ADDRESS=
NUVEM_TARGET_ASSET_ADDRESS=

# Mainnet-only operator assertion. Leave false until the complete mainnet
# canary gate in docs/runbooks/DEPLOYMENT.md has independent evidence.
NUVEM_CANARY_APPROVED=false

# packages/aa-smoke-old
AA_SMOKE_ACTION=dry-run
TRADING_OWNER_PRIVATE_KEY=
SESSION_KEY_PRIVATE_KEY=
SETTLEMENT_EXECUTOR_ADDRESS=
SESSION_NATIVE_LIMIT_WEI=
SESSION_ENTITY_ID=1
ALCHEMY_API_KEY=

# Configure both sponsorship values or leave both blank.
ALCHEMY_GAS_POLICY_ID=
ALCHEMY_PAYMASTER_ADDRESS=

# Configure both settlement values or leave both blank.
SETTLEMENT_CALLDATA=
SETTLEMENT_VALUE_WEI=
