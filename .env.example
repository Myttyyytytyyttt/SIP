# SIP — the variables `docker compose` substitutes for the web service. Copy to
# .env and fill in.
#
#   cp .env.example .env
#   docker compose up --build
#
# Names only: every value below is blank or public. What each variable means, in
# full: packages/website-oficial/.env.example.
#
# NEVER A SIGNING SECRET HERE. SIP_SOLANA_SETTLE_KEY, SIP_SOLANA_PRIVY_APP_SECRET,
# SIP_SOLANA_PRIVY_AUTHORIZATION_KEY, PRIVY_APP_SECRET and
# PRIVY_AUTHORIZATION_PRIVATE_KEY belong to the keeper's own environment, never to
# this file: compose does not pass them, and the web refuses them by name.

# --- required ----------------------------------------------------------------
# The Privy app id. Public by design, and read at request time, not at build time.
PRIVY_APP_ID=

# The web's own Helius JSON-RPC URL(s), comma-separated. It carries an API key and
# stays server-side. Use a different key from the keeper's.
SIP_SOLANA_RPC_URLS=

# An assertion: it must equal the address in
# packages/solana-program/idl/sip_vault.json.
SIP_SOLANA_PROGRAM_ID=6kA9H9zQT6PW5xWkXoAFCS3NotxarzaYqj66mjMf9w4J

# The one header the edge in front of the web writes from the connection. No edge
# sits in front of compose, so locally any header name works.
SIP_TRUSTED_CLIENT_IP_HEADER=

# --- optional ----------------------------------------------------------------
# Blank means the default.
SIP_SOLANA_PUBLIC_WS_URL=
SIP_SOLANA_PRIVY_SIGNER_ID=
SIP_SOLANA_PRIVY_POLICY_ID=
SIP_SOLANA_RELAY_PER_MIN=
SIP_SOLANA_RELAY_SIGNING_GLOBAL_PER_MIN=
SIP_SOLANA_RELAY_READS_GLOBAL_PER_MIN=
SIP_SOLANA_SEND_PER_MIN=
SIP_SOLANA_SEND_GLOBAL_PER_MIN=

# Host port for the web container, when your own dev server already holds 3002.
# SIP_WEB_PORT=3012
