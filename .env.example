# SIP — the variables each command needs. Copy to .env and fill only the
# section you are running. Never commit .env; never paste a private key into a
# log, a ticket or a deployment manifest.
#
# Per-package examples carry the detail:
#   packages/worker/.env.example              the observer and the pull
#   packages/website-oficial/.env.example     the site

# ── the chain both services read ────────────────────────────────────────────
# Alchemy Pay-As-You-Go on Robinhood Chain: the free tier caps eth_getLogs at
# ten blocks, which makes discovery impossible. Archive access is required —
# the reconciler reads balances at the block before a fill.
NUVEM_RPC_URL=
NUVEM_CHAIN_ID=4663

# No deployment addresses are known. SIP does not use Nuvem's factory: its
# vaults carry trading accounts whose savings rate is a PERCENTAGE OF PROFIT,
# and this product's rate is BASIS POINTS OF VOLUME. Pointing at it would skim
# a hundred times too much. Deploy fresh and put the addresses here.
NUVEM_VAULT_FACTORY=
NUVEM_SETTLEMENT_EXECUTOR=
SIP_LOGS_FROM_BLOCK=

# ── contracts: deployment (packages/contracts) ──────────────────────────────
# See docs/runbooks/DEPLOYMENT.md. The deploy script reads a plaintext key from
# the environment; production signer handling is not hardened yet.
DEPLOYER_PRIVATE_KEY=
