# SIP — the variables `docker compose` substitutes. Copy to .env and fill in.
#
#   cp .env.example .env
#   docker compose up --build
#
# ONE VOCABULARY: you set SIP_* here. The web app still reads the inherited
# NUVEM_* names internally and docker-compose.yml translates, so you never have
# to hold two sets of names in your head.

# --- the chain -------------------------------------------------------------
# Comma-separated; the first is preferred and the rest are failover. Needs to be
# archive-capable and to allow wide eth_getLogs ranges (a free tier caps them at
# 10 blocks, which makes discovery impossible).
SIP_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/<key>
SIP_CHAIN_ID=4663

# --- the live deployment (chain 4663, block 57746389) ----------------------
# Also recorded, with what was verified on chain, in
# packages/contracts/deployments/sip-mainnet-4663.json
SIP_VAULT_FACTORY=0xf38448a0550eB31530f58a6d613e74fb109D02Ef
SIP_SETTLEMENT_EXECUTOR=0xB87fBBAC92d52D543CB289Ee4cBdB23b6330C15c
SIP_LOGS_FROM_BLOCK=57746389
SIP_WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
SIP_PAUSE_CONTROLLER=0xC55FA33379D75E5A6725Bf99C29F94605b904679
SIP_ATTESTER_REGISTRY=0x7cD142A20E664f9318D6520A75c9e471d897e7a8
SIP_COHORT_ID=1

# The provider's eth_getLogs range cap. Too large and the provider refuses the
# request; the worker reports what it said rather than guessing.
SIP_MAX_LOG_SPAN=100000

# Loop cadence in milliseconds. Default 300000 (5 minutes).
# SIP_POLL_MS=300000

# Host port for the web container, when your own dev server already holds 3002.
# SIP_WEB_PORT=3012

# --- Privy -----------------------------------------------------------------
# The app id ships to every browser and is public by design. It is ALSO needed
# at build time: Next bakes NEXT_PUBLIC_* into the bundle, so a value that
# arrives only at runtime leaves the page serving happily with no Privy at all.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_SIGNER_ID=
PRIVY_POLICY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# --- arming ----------------------------------------------------------------
# The attester key is registered in AttesterRegistry, signs volume, and holds no
# funds. In dry run it is not read at all — the process says so on startup.
SIP_ATTESTER_PRIVATE_KEY=

# THE ONLY THING BETWEEN A DRY RUN AND REAL MONEY. Compared byte for byte, so a
# trailing newline or a change of case leaves it in dry run — and it says so.
# SIP_WORKER_ALLOW_BROADCAST=i-understand-this-moves-real-funds

# Set to use a database other than the compose Postgres. Must be a session
# connection (port 5432, never a 6543 transaction pooler): advisory locks are
# session scoped, and through a pooler the lock would appear granted and hold
# nothing, so two workers would run believing they were alone.
# SIP_DATABASE_URL=
