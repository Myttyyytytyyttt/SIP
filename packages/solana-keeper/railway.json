{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/solana-keeper/Dockerfile",
    "watchPatterns": [
      "packages/solana-keeper/**",
      "packages/solana-program/idl/**",
      "packages/solana-program/scripts/**",
      "packages/solana-program/package.json",
      "packages/worker/src/log.ts",
      "packages/worker/package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
