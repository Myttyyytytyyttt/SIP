{
  "name": "@sip/web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "description": "SIP \u2014 Self Implemented Pension. The savings dashboard: what each trade put aside, what it adds up to, and the wallet activity behind it. Mock data until the backend exists.",
  "scripts": {
    "dev": "next dev --port 3002",
    "prebuild": "pnpm run check:csp && pnpm run check:idl",
    "build": "next build",
    "start": "next start --port 3002",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:csp": "tsx scripts/check-csp.mts",
    "check:idl": "pnpm --dir ../solana-core run check:idl",
    "verify": "pnpm run check:csp && pnpm run check:idl && pnpm run typecheck && pnpm run test && next build"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.36.0",
    "@sip/solana-core": "workspace:*",
    "@solana-program/memo": "0.8.0",
    "@solana-program/system": "0.10.0",
    "@solana-program/token": "0.9.0",
    "@solana/kit": "5.5.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.41.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
