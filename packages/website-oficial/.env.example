# -----------------------------------------------------------------------------
# @sip/web — configuration
#
#   cp packages/website-oficial/.env.example packages/website-oficial/.env.local
#
# HOW THESE ARE READ
# The server reads them at REQUEST time (src/lib/load-config.ts, called from the
# pages and from the Solana route handlers) and passes only the browser-safe
# subset to the client as props. Nothing is inlined at build time, so ONE Docker
# image runs unchanged locally, on a VPS and on Railway: changing an endpoint is a
# restart, not a rebuild.
#
# NOTE FOR LOCAL RUNS: `next dev` loads this file automatically. The production
# standalone server (what the container runs) does NOT — and .dockerignore keeps
# .env files out of the image on purpose — so a deployment must supply real
# environment variables.
#
# SIP IS SOLANA-ONLY. Every problem is reported at once, by variable name, in the
# setup checklist (/wallets, and the dashboard's wallets modal). A problem never
# repeats a secret value.
# -----------------------------------------------------------------------------

# --- REQUIRED ----------------------------------------------------------------

# Privy App ID.  aliases: PRIVY_APP_ID, SIP_PRIVY_APP_ID, NEXT_PUBLIC_PRIVY_APP_ID
# Public by design (it identifies your app, it authorises nothing). What actually
# stops someone else using it is the Allowed-origins list in the Privy dashboard,
# so treat that list as a security control and fill it in.
#
#   1. https://dashboard.privy.io -> Create app -> Web platform. Copy the App ID
#      (a short opaque string, looks like cm…, exactly 25 chars — the server
#      checks the length because Privy 500s every page on any other).
#   2. Configuration -> Login methods -> ENABLE "Wallet". Skip this and the login
#      modal opens with no wallet option and no console error — it just looks
#      broken.
#   3. Configuration -> App settings -> Domains -> Allowed origins: add
#      http://localhost:3002 (the port is mandatory, Privy will not infer it),
#      and later your production origin. https required for non-localhost.
#   4. Embedded wallets -> execution mode: TEE ("user-controlled server
#      wallets"). Importing a trading wallet with a seat only works in TEE
#      mode; on-device mode attaches no signer.
PRIVY_APP_ID=

# The web's own Helius JSON-RPC URL(s), comma-separated, tried in order.
# SERVER-SIDE ONLY, and it carries an API key: it is never returned in a
# response, logged, placed in the CSP or handed to Privy. Nothing is appended
# implicitly; list a second provider yourself if you have one. Use a different
# key from the keeper's.
SIP_SOLANA_RPC_URLS=

# An assertion, not the source: it must equal the address in
# packages/solana-program/idl/sip_vault.json, which is what the code uses.
# Nuvem's 7rtgXTu852M1NTx7PLoJd3bChaCb2hgsgv5o54aFv6Fy is refused by name.
SIP_SOLANA_PROGRAM_ID=6kA9H9zQT6PW5xWkXoAFCS3NotxarzaYqj66mjMf9w4J

# The ONE header the edge in front of this process writes from the connection.
# The per-client limits key on it and ignore every other header; a request
# without it shares one bucket. On Railway, Envoy writes x-envoy-external-address
# (confirm by echoing headers on the deployed service). x-forwarded-for,
# forwarded and x-client-ip are refused: a client writes those itself.
SIP_TRUSTED_CLIENT_IP_HEADER=

# --- OPTIONAL ----------------------------------------------------------------

# The key-free Solana WebSocket handed to the browser (Privy's rpcSubscriptions),
# and the only Solana origin in the CSP. Default wss://api.mainnet-beta.solana.com.
# A wss:// origin only: a path, a query, credentials, or the host of any
# SIP_SOLANA_RPC_URLS entry is refused, because that is where a key hides. The
# browser's HTTP RPC has no variable: it is always this app's own /api/solana-rpc.
SIP_SOLANA_PUBLIC_WS_URL=

# Both or neither. The solana-keeper's Privy signer id, and the Solana policy
# (chain_type solana) that bounds it, seated on trading wallets by the wallet
# screens. Ids, not keys. They replace the EVM-era PRIVY_SIGNER_ID and
# PRIVY_POLICY_ID, which are no longer read.
SIP_SOLANA_PRIVY_SIGNER_ID=
SIP_SOLANA_PRIVY_POLICY_ID=

# Privy App Client ID.  aliases: PRIVY_CLIENT_ID, SIP_PRIVY_CLIENT_ID, NEXT_PUBLIC_PRIVY_CLIENT_ID
# Only needed if you created an App Client to separate dev/staging/prod.
PRIVY_CLIENT_ID=

# Budgets, in weighted tokens per minute (weights: @sip/solana-core
# relay-policy.ts). In memory and per process, which is right for the single web
# replica. Blank means the default.
#   SIP_SOLANA_RELAY_PER_MIN                 per client, /api/solana-rpc (default 60, minimum 30)
#   SIP_SOLANA_RELAY_SIGNING_GLOBAL_PER_MIN  whole process, wallet-signing methods (default 1800)
#   SIP_SOLANA_RELAY_READS_GLOBAL_PER_MIN    whole process, account reads (default 1800)
#   SIP_SOLANA_SEND_PER_MIN                  per client, /api/solana-tx (default 6)
#   SIP_SOLANA_SEND_GLOBAL_PER_MIN           whole process, verified sends only (default 150)
# SIP_SOLANA_RELAY_GLOBAL_PER_MIN is refused by name: it was split into the two
# global budgets above, so reads can never starve signing.
#
# WHAT IT TAKES TO DENY EVERYONE: a global budget divided by its per-client limit
# is the number of client identities that, each spending its whole allowance,
# empty that budget for every visitor. A client is one IPv4 address or one IPv6
# /64; every IPv4 /24 and IPv6 /48 also shares one bucket of 4 x the per-client
# limit, so a home /56 or a tunnel /48 counts as at most 4 clients. The defaults
# keep the ratio at 25 or more (30 for the relay, 25 for sends). Change a limit
# only in the direction that keeps it there. Size the two relay globals together
# against the Helius plan: requests per second x 60 (a batch member is one request
# upstream, whatever it weighs here). Fixed in code: at most 32 relays in flight
# at once (6 per client); past that the relay answers 503 or 429 at once.
SIP_SOLANA_RELAY_PER_MIN=
SIP_SOLANA_RELAY_SIGNING_GLOBAL_PER_MIN=
SIP_SOLANA_RELAY_READS_GLOBAL_PER_MIN=
SIP_SOLANA_SEND_PER_MIN=
SIP_SOLANA_SEND_GLOBAL_PER_MIN=

# =============================================================================
# REFUSED, NOT READ
#
# Each of these is a problem naming the variable, and while any of them is
# present /api/solana-rpc and /api/solana-tx answer 503 with no detail. The
# secret names are checked by NAME, so do not leave any of them here, even blank.
#
# - Nuvem's Solana configuration: every NUVEM_SOLANA_* name (NUVEM_SOLANA_RPC_URL,
#   NUVEM_SOLANA_PROGRAM_ID, NUVEM_SOLANA_PUBLIC_WS_URL, …). The problem names the
#   SIP_SOLANA_* replacement, because Nuvem's program key leaked. Nuvem's program
#   id in SIP_SOLANA_PROGRAM_ID is refused the same way.
# - The keeper's signing secrets: SIP_SOLANA_SETTLE_KEY,
#   SIP_SOLANA_PRIVY_APP_SECRET and SIP_SOLANA_PRIVY_AUTHORIZATION_KEY. The web
#   never signs.
# - Privy server credentials: PRIVY_APP_SECRET and
#   PRIVY_AUTHORIZATION_PRIVATE_KEY. The web never calls Privy's server API.
# - SIP_CHAIN with any value other than solana. SIP_CHAIN is no longer read; an
#   unset, blank or solana value is accepted, so it can simply be deleted.
#
# NAMED, NOT REFUSED: the EVM-era names this app used to read — NUVEM_RPC_URL and
# its SIP_RPC_URL / RPC_URL spellings, NUVEM_PUBLIC_RPC_URL and its spellings,
# PRIVY_SIGNER_ID and PRIVY_POLICY_ID, and the factory, executor, WETH, pause
# controller, attester registry, cohort, logs-from-block, chain id, explorer and
# RPC-proxy variables. Nothing reads them. The first time a server process sees
# any of them non-blank it logs one warning listing their names, never a value.
# =============================================================================
