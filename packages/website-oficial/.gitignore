# Next build output. The root .gitignore covers dist/ but not this.
.next/
out/

# TypeScript incremental state, written by `pnpm run typecheck`.
*.tsbuildinfo

# Generated by `next dev` / `next build`; harmless to commit but noisy.
next-env.d.ts

# .env files are already ignored by the root .gitignore (.env, .env.*, with
# .env.example re-included). Repeated here so it is visible from inside the
# package: .env.local holds a real RPC URL with an API key.
.env
.env.*
!.env.example
