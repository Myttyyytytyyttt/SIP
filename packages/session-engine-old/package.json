{
  "name": "@nuvem/session-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reconstructs a trading session's realized PnL from chain state and decides whether it is attestable",
  "exports": {
    ".": {
      "types": "./dist/src/session.d.ts",
      "import": "./dist/src/session.js",
      "default": "./dist/src/session.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/check-settle-selector.mts && vitest run",
    "record-fixture": "tsx scripts/record-fixture.mts",
    "session-report": "tsx scripts/session-report.mts",
    "check:selector": "tsx scripts/check-settle-selector.mts"
  },
  "dependencies": {
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@nuvem/contracts-artifacts": "workspace:*",
    "@types/node": "22.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
