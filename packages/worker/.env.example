# @sip/worker — every variable, and why. Dry run needs only the first block.

# ── chain ───────────────────────────────────────────────────────────────────
SIP_RPC_URLS=https://robinhood-mainnet.g.alchemy.com/v2/<key>   # comma-separated, preferred first; Pay-As-You-Go tier (eth_getLogs range unlimited on 4663)
SIP_CHAIN_ID=4663
SIP_VAULT_FACTORY=0x783BDF0281090f21928398cC3Da19cFb64Fed15E     # 2026-08-16 topology; the worker verifies protocolConfiguration() at boot
SIP_SETTLEMENT_EXECUTOR=0xfA92ABF15dFAf470Cc8833Cb01464bD6CA139e16 # Phase 0: the deployed SettlementExecutor; Phase 1: SipVolumeExecutor
SIP_LOGS_FROM_BLOCK=37531900                                       # first L2 block worth scanning for TradingAccountLinked

# ── storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://...                                        # session pooler on 5432, never 6543

# ── live mode only (the process refuses to read these in dry run) ───────────
SIP_WORKER_ALLOW_BROADCAST=                                        # must be exactly: i-understand-this-moves-real-funds
SIP_ATTESTER_PRIVATE_KEY=                                          # the key registered in AttesterRegistry; signs volume, holds no funds
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=                                   # the app's additional-signer key; policy-bounded to the executor's pull
