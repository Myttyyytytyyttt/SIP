{
  "name": "@sip/solana-core",
  "private": true,
  "version": "0.1.0",
  "description": "SaverFi's Solana web core: the IDL-driven codec and decoders the browser may load, and the server-only relay policy, transaction verifier, RPC pool, builders and readers behind /api/solana-rpc and /api/solana-tx. It never settles, invests, converts or wraps: packages/solana-keeper owns that.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": "./src/client/index.ts",
    "./server": "./src/server/index.ts",
    "./public-ws-url": {
      "types": "./src/shared/public-ws-url.d.mts",
      "default": "./src/shared/public-ws-url.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:idl": "tsx bin/check-idl.mts"
  },
  "dependencies": {
    "@sip/solana-program": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@types/node": "22.20.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
