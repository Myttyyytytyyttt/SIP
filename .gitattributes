# Line endings.
#
# `* text=auto` lets git normalise to LF in the repository while checking out
# whatever the platform prefers. That is the right default; the files below are
# pinned to LF regardless.
* text=auto

# Lockfiles are LF everywhere by convention; pnpm writes LF and does not expect
# to see it changed underneath it.
pnpm-lock.yaml text eol=lf

# Shell scripts must be LF. A CRLF checkout breaks the shebang under WSL and
# Linux ("bad interpreter"), and secrets-bundle.sh is the first thing a second
# machine runs -- before there is any environment in which to debug it.
*.sh text eol=lf
