{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/website-oficial/Dockerfile",
    "watchPatterns": [
      "packages/website-oficial/**",
      "packages/contracts-artifacts/dist/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
